# API mode needs this key. Subscription mode uses the local Claude Code login
# reported by `claude auth status` instead. A BLANK LINE MEANS UNSET: an empty
# ANTHROPIC_API_KEY= would otherwise win its slot and 401 with an empty key,
# which is why main.py skips empty values.
ANTHROPIC_API_KEY=

# Optional planner override. HTML is deterministic and uses no model.
# VIDEO_MODEL=claude-haiku-4-5
